# --- Listeners ---------------------------------------------------------------
# BLOCKCLOCK_HOST=0.0.0.0
# BLOCKCLOCK_PORT=21021
# Compose defaults HEALTH_HOST to 127.0.0.1; bare python defaults to 0.0.0.0.
# Set HEALTH_PORT=0 or leave it empty to disable the health HTTP listener.
# HEALTH_HOST=127.0.0.1
# HEALTH_PORT=8080
# HEALTH_PORT=0

# --- Bitcoin source: rpc | electrum | mock -----------------------------------
# The normal production choice when this container runs on the Bitcoin node.
BITCOIN_SOURCE=rpc
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_USER=blockclock
BITCOIN_RPC_PASSWORD=change-me-to-a-dedicated-rpcauth-password
# Prefer user/pass over sharing the node cookie with the container UID.
# BITCOIN_RPC_COOKIE_FILE=/run/bitcoin/.cookie

# Or use an Electrum server instead:
# BITCOIN_SOURCE=electrum
# ELECTRUM_HOST=127.0.0.1
# ELECTRUM_PORT=50001
# ELECTRUM_TLS=false
# TLS Electrum (often port 50002):
# ELECTRUM_PORT=50002
# ELECTRUM_TLS=true

# Local development without a node:
# BITCOIN_SOURCE=mock
# MOCK_BLOCK_HEIGHT=840000

# --- BTC/USD price -----------------------------------------------------------
# Copy this file to .env and edit there. Compose reads venue URLs from .env only.
#
# cm.markets.price = equal-weight average of every venue with a non-empty URL.
# coinbase.BTC-USD.spot = PRICE_COINBASE_URL only (not the average).
#
# Include/exclude: comment out a venue block, or set its URL to empty.
# Example exclude:  PRICE_GEMINI_URL=
PRICE_CACHE_SECONDS=30

PRICE_COINBASE_URL=https://api.coinbase.com/v2/prices/BTC-USD/spot
PRICE_COINBASE_JSON_PATH=data.amount

PRICE_KRAKEN_URL=https://api.kraken.com/0/public/Ticker?pair=XBTUSD
PRICE_KRAKEN_JSON_PATH=result.XXBTZUSD.c.0

PRICE_BITSTAMP_URL=https://www.bitstamp.net/api/v2/ticker/btcusd/
PRICE_BITSTAMP_JSON_PATH=last

PRICE_GEMINI_URL=https://api.gemini.com/v1/pubticker/btcusd
PRICE_GEMINI_JSON_PATH=last

# Optional overrides (static wins; PRICE_URL replaces the venue average):
# BITCOIN_PRICE_USD=64520
# PRICE_URL=http://127.0.0.1:3000/api/price
# PRICE_JSON_PATH=price

# --- Runtime -----------------------------------------------------------------
LOG_LEVEL=INFO
CACHE_SECONDS=15
# REQUEST_TIMEOUT=8
