# --- Listeners ---------------------------------------------------------------
# BLOCKCLOCK_HOST=0.0.0.0
# BLOCKCLOCK_PORT=21021
# Compose defaults HEALTH_HOST to 127.0.0.1; bare python defaults to 0.0.0.0.
# Set HEALTH_PORT=0 or leave it empty to disable the health HTTP listener.
# HEALTH_HOST=127.0.0.1
# HEALTH_PORT=8080
# HEALTH_PORT=0

# --- Bitcoin source: rpc | electrum | mock -----------------------------------
# The normal production choice when this container runs on the Bitcoin node.
BITCOIN_SOURCE=rpc
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_USER=blockclock
BITCOIN_RPC_PASSWORD=change-me-to-a-dedicated-rpcauth-password
# Prefer user/pass over sharing the node cookie with the container UID.
# BITCOIN_RPC_COOKIE_FILE=/run/bitcoin/.cookie

# Or use an Electrum server instead:
# BITCOIN_SOURCE=electrum
# ELECTRUM_HOST=127.0.0.1
# ELECTRUM_PORT=50001
# ELECTRUM_TLS=false
# TLS Electrum (often port 50002):
# ELECTRUM_PORT=50002
# ELECTRUM_TLS=true

# Local development without a node:
# BITCOIN_SOURCE=mock
# MOCK_BLOCK_HEIGHT=840000

# --- Optional BTC/USD price --------------------------------------------------
# Leave both approaches unset for node-only operation; price-related tags will
# show a clear offline/error value. Static price wins if both are set.
# BITCOIN_PRICE_USD=64520
# PRICE_URL=http://127.0.0.1:3000/api/price
# PRICE_JSON_PATH=price

# --- Runtime -----------------------------------------------------------------
LOG_LEVEL=INFO
CACHE_SECONDS=15
# REQUEST_TIMEOUT=8
